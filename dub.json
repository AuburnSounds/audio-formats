{
    "name": "audio-formats",
    "description": "Streaming decoding support for popular audio formats.",
    "license": "BSL-1.0",

    "dependencies":
    {
        "nulib:stdc": {
            "version": ">=0.3.0",
            "optional": true,
            "default": false
        },
        "nurt": {
            "version": ">=0.2.1",
            "optional": true,
            "default": false
        }
    },

    "configurations": [
        {
            "name": "boost",
            "versions": ["decodeWAV",                           "decodeMP3", "decodeFLAC", "decodeOGG",               "decodeMOD", "decodeXM",
                         "encodeWAV"]
        },
        {
            "name": "mit",
            "versions": ["decodeWAV", "decodeQOA", "encodeQOA", "decodeMP3", "decodeFLAC", "decodeOGG",               "decodeMOD", "decodeXM",
                         "encodeWAV" ]
        },
        {
            "name": "lgpl",
            "versions": ["decodeWAV", "decodeQOA", "encodeQOA", "decodeMP3", "decodeFLAC", "decodeOGG", "decodeOPUS", "decodeMOD", "decodeXM",
                         "encodeWAV"]
        }
    ]
}
